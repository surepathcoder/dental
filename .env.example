# ─────────────────────────────────────────────────────────────────────────────
# BrightSmile Dental — AI Receptionist & Patient Automation Platform
# Copy to .env (backend) and .env.local (frontend). NEVER commit real keys.
#
# The entire application runs with NONE of these set: DEMO_MODE=true makes the
# AI, scheduler, email and SMS fall back to safe, simulated implementations.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ────────────────────────────────────────────────────────────────────
DEMO_MODE=true
APP_ENV=development

# Leave empty to use a local SQLite file (backend/brightsmile_demo.db).
# PostgreSQL example: postgresql://user:password@localhost:5432/brightsmile
DATABASE_URL=

# ── AI provider (optional — rule-based answers are used when unset) ─────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Email (Gmail SMTP) — sent for real when both are set, even in DEMO_MODE ─
# Create an App Password: Google Account → Security → 2-Step Verification → App passwords
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=BrightSmile Dental

# ── Email (Resend) — used only when Gmail is not configured; simulated while DEMO_MODE=true ─
RESEND_API_KEY=
RESEND_FROM_EMAIL=BrightSmile Dental <onboarding@resend.dev>

# ── SMS (Twilio) — simulated while DEMO_MODE=true ──────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Scheduling (Cal.com) — mock scheduler is used when unset ───────────────
CAL_API_KEY=
CAL_EVENT_TYPE_ID=

# ── Security ───────────────────────────────────────────────────────────────
# Required when DEMO_MODE=false. In demo mode "demo-admin-key" is accepted.
ADMIN_API_KEY=
# Comma-separated origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
CHAT_RATE_LIMIT_PER_MINUTE=30

# ── Background jobs ────────────────────────────────────────────────────────
ENABLE_SCHEDULER=true
SCHEDULER_INTERVAL_SECONDS=60
ABANDONED_CHAT_MINUTES=30
# Idle chat memory (booking stage, collected fields) expires after this many minutes.
CHAT_SESSION_TTL_MINUTES=60

PUBLIC_SITE_URL=http://localhost:3000
CLINIC_TIMEZONE=America/Chicago

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND (frontend/.env.local)
# ─────────────────────────────────────────────────────────────────────────────

# Server-side only: where the Next.js route handler forwards API calls.
API_URL=http://localhost:8000
# Must match the backend's ADMIN_API_KEY (server-side only, never exposed).
ADMIN_API_KEY=
# Optional: set to password-protect /admin. Unset = open dashboard (demo).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Exposed to the browser (safe, public values only)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_AGENCY_EMAIL=hello@example.com
NEXT_PUBLIC_AGENCY_CALENDAR_URL=
